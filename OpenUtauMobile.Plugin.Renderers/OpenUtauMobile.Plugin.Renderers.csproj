<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- 桌面/Android 等平台使用 net10.0；仅在 macOS 构建机上扩展出 net10.0-ios，
             使 iOS 头项目能精确匹配到该变体（避免在 Windows/Linux 上触发缺 ios workload 的错误）。 -->
        <TargetFrameworks>net10.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0;net10.0-ios</TargetFrameworks>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="NAudio.Core" Version="2.2.1" />
        <PackageReference Include="NWaves" Version="0.9.6" />
        <PackageReference Include="Serilog" Version="4.1.0" />
    </ItemGroup>

    <ItemGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">
        <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.0" />
    </ItemGroup>
    <ItemGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'false'">
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\OpenUtau.Core\OpenUtau.Core.csproj" />
    </ItemGroup>

</Project>
