<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenUtauMobile.ViewModels"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:theme="clr-namespace:OpenUtauMobile.Themes.OpenUtauMobile.Runtime"
             mc:Ignorable="d"
             x:Class="OpenUtauMobile.Controls.PianoRollBatchEditBar"
             x:DataType="vm:PianoRollViewModel"
             d:DesignHeight="52"
             d:DesignWidth="420">
    <!-- 钢琴卷帘批处理工具栏（对齐上游 OpenUtau 的钢琴卷帘菜单栏） -->
    <UserControl.Styles>
        <Style Selector="Button.MenuItemBtn">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="{x:Static theme:ThemeSemLayoutTokens.InsetButtonCompact}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{x:Static theme:ThemeBaseShapeTokens.CornerM}" />
            <Setter Property="Foreground" Value="{DynamicResource Sem.Color.OnSurface}" />
            <Setter Property="FontSize" Value="{x:Static theme:ThemeSemTypographyTokens.BodyMSize}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.MenuItemBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sem.Color.SurfaceContainerHigh}" />
        </Style>
        <Style Selector="Button.MenuItemBtn.DangerBtn">
            <Setter Property="Foreground" Value="{DynamicResource Sem.Color.Error}" />
        </Style>
    </UserControl.Styles>
    <Border Background="{DynamicResource Sem.Color.SurfaceContainerLow}"
            BorderBrush="{DynamicResource Sem.Color.OutlineVariant}"
            BorderThickness="0,0,0,1"
            Padding="{x:Static theme:ThemeSemLayoutTokens.InsetXS}">
        <Grid>
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="2">
                <!-- 全选 -->
                <Button Classes="TopBarBtn"
                        Command="{Binding SelectAllCommand}"
                        ToolTip.Tip="{DynamicResource PianoRoll.Menu.SelectAll}"
                        Content="{iconPacks:PhosphorIcons SelectionAll}" />
                <!-- 降低八度 -->
                <Button Classes="TopBarBtn"
                        Command="{Binding TransposeDownOctaveCommand}"
                        ToolTip.Tip="{DynamicResource PianoRoll.Menu.OctaveDown}"
                        Content="{iconPacks:PhosphorIcons ArrowLineDown}" />
                <!-- 升高八度 -->
                <Button Classes="TopBarBtn"
                        Command="{Binding TransposeUpOctaveCommand}"
                        ToolTip.Tip="{DynamicResource PianoRoll.Menu.OctaveUp}"
                        Content="{iconPacks:PhosphorIcons ArrowLineUp}" />

                <!-- 分隔线 -->
                <Border Width="1"
                        Background="{DynamicResource Sem.Color.OutlineVariant}"
                        Margin="4,8" />

                <!-- 歌词批处理菜单 -->
                <Button Classes="TopBarBtn"
                        Click="OnDropdownClick"
                        Tag="{Binding LyricBatchActions}"
                        ToolTip.Tip="{DynamicResource PianoRoll.Menu.Lyrics}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="1"
                                VerticalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons Kind="TextAa" />
                        <iconPacks:PackIconPhosphorIcons Kind="CaretDown" />
                    </StackPanel>
                </Button>

                <!-- 音符批处理菜单 -->
                <Button Classes="TopBarBtn"
                        Click="OnDropdownClick"
                        Tag="{Binding NoteBatchActions}"
                        ToolTip.Tip="{DynamicResource PianoRoll.Menu.Notes}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="1"
                                VerticalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons Kind="MusicNotes" />
                        <iconPacks:PackIconPhosphorIcons Kind="CaretDown" />
                    </StackPanel>
                </Button>

                <!-- 重置批处理菜单 -->
                <Button Classes="TopBarBtn"
                        Click="OnDropdownClick"
                        Tag="{Binding ResetBatchActions}"
                        ToolTip.Tip="{DynamicResource PianoRoll.Menu.Reset}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="1"
                                VerticalAlignment="Center">
                        <iconPacks:PackIconPhosphorIcons Kind="ArrowsClockwise" />
                        <iconPacks:PackIconPhosphorIcons Kind="CaretDown" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 下拉菜单弹层 -->
            <Popup x:Name="MenuPopup"
                   IsLightDismissEnabled="True"
                   Placement="Bottom"
                   VerticalOffset="{x:Static theme:ThemeBaseLayoutTokens.SpaceXS}">
                <Border Background="{DynamicResource Sem.Color.SurfaceContainer}"
                        CornerRadius="{x:Static theme:ThemeBaseShapeTokens.CornerL}"
                        Padding="{x:Static theme:ThemeSemLayoutTokens.InsetXS}"
                        MinWidth="180">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12"
                                          OffsetX="0"
                                          OffsetY="4"
                                          Opacity="0.24"
                                          Color="{DynamicResource Sem.Value.Shadow}" />
                    </Border.Effect>
                    <StackPanel x:Name="MenuPanel"
                                Orientation="Vertical"
                                Spacing="2" />
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
