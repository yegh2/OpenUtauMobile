<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-ios</TargetFramework>
        <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

	<!-- iOS 配置 -->
	<PropertyGroup>
		<!-- 禁用 IL 链接器以避免 DryWetMidi 等库的问题 -->
		<MtouchLink>None</MtouchLink>
	</PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" Version="$(AvaloniaVersion)"/>
    </ItemGroup>

    <!-- Assets.xcassets 不会自动包含（非 MAUI 项目），需显式声明为 ImageAsset，
         构建时由 actool 编译成 Assets.car 打进 .app，否则 App 图标不生效 -->
    <ItemGroup>
        <ImageAsset Include="Assets.xcassets\**\*.png"/>
        <ImageAsset Include="Assets.xcassets\**\Contents.json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenUtauMobile\OpenUtauMobile.csproj"/>
    </ItemGroup>
</Project>
